# --- Configuración de Servidor ---
PORT=3000

# --- Integración con Azure OpenAI (Requerido para producción) ---
# Endpoint completo de Azure OpenAI (ej. https://mi-recurso.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# Llave API de Azure OpenAI
AZURE_OPENAI_KEY=your-api-key-here
# Nombre del despliegue del modelo (ej. gpt-4o)
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Versión de la API de OpenAI
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Integración con Microsoft Teams (Opcional para pruebas) ---
# URL del webhook entrante o workflow de Teams para reportar incidentes
TEAMS_WEBHOOK_URL=https://your-teams-webhook-url-here

# --- Configuración de Seguridad y Comportamiento ---
# Activar modo simulación automática si no se detectan llaves reales (true/false)
FALLBACK_TO_SIMULATION=true
